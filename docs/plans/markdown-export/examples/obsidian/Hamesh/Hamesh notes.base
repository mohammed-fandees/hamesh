filters:
  and:
    - file.hasTag("hamesh")
    - file.inFolder("Hamesh/Sites")
properties:
  note.notes:
    displayName: Notes
  note.updated:
    displayName: Last written
views:
  - type: table
    name: Every page
    order:
      - file.name
      - site
      - kind
      - notes
      - updated
      - folders
    sort:
      - property: updated
        direction: DESC
  - type: table
    name: Videos
    filters:
      and:
        - file.hasTag("hamesh/video")
    order:
      - file.name
      - duration
      - notes
      - updated
