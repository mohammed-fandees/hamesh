filters:
  and:
    - file.hasTag("hamesh")
    - file.inFolder("Hamesh/Sites")
properties:
  note.site:
    displayName: "Site"
  note.layout:
    displayName: "Layout"
  note.notes:
    displayName: "Notes"
  note.updated:
    displayName: "Last written"
views:
  - type: table
    name: "Pages"
    order:
      - file.name
      - site
      - kind
      - layout
      - notes
      - updated
    sort:
      - property: updated
        direction: DESC
